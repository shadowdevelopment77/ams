# Postgres connection string. Recommended: Neon (https://neon.tech) free tier.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Server
PORT=3000
NODE_ENV=development

# Must match the frontend's dev origin exactly (Vite's default is 5173).
# credentials:true is required because auth uses a session cookie — a
# wildcard origin can't be paired with credentials per the CORS spec.
CORS_ORIGIN=http://localhost:5173

# Cloudinary — used for check-in/check-out selfies, checklist photos, and
# visit-log photos (see src/lib/cloudinary.ts and src/utils/uploadImage.ts).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
