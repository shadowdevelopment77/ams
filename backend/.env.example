# Postgres connection string (Neon). Get this from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cloudinary -- get these from your Cloudinary dashboard (Settings > API Keys).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Set to "production" in a real deploy -- flips cookie secure/sameSite flags
# and blocks the dev-only seed admin account from being (re)created.
NODE_ENV=development

# Only needed for local dev -- Render (and most hosts) set this automatically.
PORT=3000

# Comma-separated list of frontend origins allowed to call this API.
# Must be your real deployed frontend URL(s) in production.
CORS_ORIGIN=http://localhost:5174

# How long a login session lasts, in hours. Defaults to 2 if unset.
SESSION_TTL_HOURS=2

# Shared secret the GitHub Actions reset-demo workflow sends as a Bearer
# token to POST /api/admin/reset-demo. Generate a long random string
# (e.g. `openssl rand -hex 32`) and put the SAME value here and in the
# GitHub repo secret of the same name.
RESET_DEMO_SECRET=change-me-to-a-long-random-string
